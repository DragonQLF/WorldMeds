# Google OAuth2 Configuration
# Replace with your actual Google OAuth2 Client ID
GOOGLE_CLIENT_ID=your_google_client_id_here

# JWT Configuration
# Replace with a strong secret key for JWT token signing
JWT_SECRET=your_jwt_secret_here

# Database Configuration
# Replace with your actual database credentials
DB_HOST=localhost
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name

# Email Configuration
# Replace with your actual email service credentials
# For Mailtrap (development/testing):
EMAIL_HOST=sandbox.smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USER=your_mailtrap_user
EMAIL_PASSWORD=your_mailtrap_password

# For Gmail (production):
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USER=your_email@gmail.com
# EMAIL_PASSWORD=your_app_specific_password

# Frontend URL
# Replace with your actual frontend URL
FRONTEND_URL=http://localhost:8080

# Node Environment
NODE_ENV=development
